+    ($] < 5.005 ? () :
+      (
+        ABSTRACT =3D> 'Embed a Perl interpreter in the Apache HTTP =
server',
+        AUTHOR   =3D> 'Doug MacEachern <dougm@pobox.com>',
+      )),
     #should override `CCFLAGS', can't with older perls
     #CCDLFLAGS =3D> "$Config{ccdlflags} $EXTRA_CFLAGS",=20
     DEFINE =3D> $EXTRA_CFLAGS,=20
--- src/modules/ApacheModulePerl/ApacheModulePerl.dsp.orig	Sat Mar 04 =
22:15:44 2000
+++ src/modules/ApacheModulePerl/ApacheModulePerl.dsp	Fri Sep 08 =
22:17:10 2000
@@ -92,6 +92,10 @@
 # End Source File
